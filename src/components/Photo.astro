---
// Affiche une photo de src/assets/photos/ ou found/, optimisée (AVIF/WebP + srcset).
// Si le fichier n'existe pas encore, un visuel de marque prend sa place.
//
// Netteté : les photos sont souvent recadrées (object-fit: cover) dans des cadres verticaux,
// alors que les fichiers sont horizontaux ou carrés. L'image affichée est alors plus large que
// son cadre, et le navigateur, qui choisit la version à télécharger d'après `sizes`, prenait
// une version trop petite puis l'étirait (effet pixelisé). On corrige `sizes` en tenant compte
// de ce recadrage, à partir du rapport largeur/hauteur du cadre le plus étroit (`box`).
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Symbol from '../assets/logo/the-next-move-symbole.svg';

interface Props {
  name: string; // nom du fichier sans extension, ex. « tatiana-rizk »
  alt: string;
  class?: string;
  sizes?: string;
  box?: number; // rapport largeur/hauteur du cadre d'affichage le plus vertical (4/5 par défaut)
  priority?: boolean;
}

const { name, alt, class: className, sizes = '(max-width: 1020px) 90vw, 480px', box = 0.75, priority = false } = Astro.props;

// photos/ : photos de Tatiana. found/ : images libres de droits (crédits dans found/credits.json, affichés en pied de page).
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/{photos,found}/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const match = Object.entries(photos).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === name);
const src = match?.[1].default;

// Facteur d'agrandissement dû au recadrage : une image 16:9 dans un cadre 3:4 est affichée ~2,4× plus large que le cadre.
const crop = src ? Math.max(1, src.width / src.height / box) : 1;
// Applique ce facteur à la largeur de chaque entrée de `sizes`, sans toucher aux conditions média.
const cropSizes = sizes
  .split(',')
  .map((entry) => entry.trim().replace(/(\d+(?:\.\d+)?)(px|vw)\s*$/, (_, n, unit) => `${Math.round(Number(n) * crop)}${unit}`))
  .join(', ');
// Versions générées : paliers usuels jusqu'à la taille du fichier d'origine (jamais d'agrandissement).
const widths = src ? [...[320, 480, 640, 800, 1080, 1280, 1600, 1920, 2400].filter((w) => w < src.width), src.width] : [];
---
{src ? (
  <Picture
    src={src}
    alt={alt}
    class={className}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    quality={80}
    widths={widths}
    sizes={cropSizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
) : (
  <div class:list={[className, 'photo-fallback']} role="img" aria-label={alt}>
    <Symbol width={120} height={120} aria-hidden="true" />
  </div>
)}

<style>
  .photo-fallback { display: grid; place-items: center; background: var(--creme-2); aspect-ratio: 4 / 5; }
  .photo-fallback :global(svg) { width: 34%; height: auto; opacity: .9; }
</style>
