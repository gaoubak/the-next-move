---
// « Ils m'ont fait confiance » — alimenté par src/content/clients.json. Rien ne s'affiche si la liste est vide.
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

interface Props { alt?: boolean }
const clients = (await getCollection('clients')).sort((a, b) => a.data.order - b.data.order);
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/clients/*.{svg,png,jpg,jpeg,webp}', { eager: true });
const logoFor = (file?: string) => file && Object.entries(logos).find(([p]) => p.endsWith(`/${file}`))?.[1].default;
---
{clients.length > 0 && (
  <section class:list={['trust', { alt: Astro.props.alt }]}>
    <div class="wrap">
      <h2 class="reveal">Ils m’ont fait confiance</h2>
      <ul data-stagger>
        {clients.map(({ data }) => {
          const logo = logoFor(data.logo);
          const inner = logo
            ? <Image src={logo} alt={data.name} height={48} format="webp" />
            : <span class="name">{data.name}</span>;
          return <li>{data.url ? <a href={data.url} target="_blank" rel="noopener">{inner}</a> : inner}</li>;
        })}
      </ul>
    </div>
  </section>
)}

<style>
  .trust { padding: 72px 0; }
  h2 { text-align: center; margin-bottom: 36px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 24px 56px; }
  li :global(img) { height: 40px; width: auto; filter: grayscale(1); opacity: .7; transition: filter .3s, opacity .3s; }
  li:hover :global(img) { filter: none; opacity: 1; }
  .name { font-family: var(--serif); font-size: 24px; color: var(--muted); transition: color .3s; }
  li:hover .name { color: var(--olive); }
  a { text-decoration: none; }
</style>
