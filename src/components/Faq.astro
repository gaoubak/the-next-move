---
// Questions fréquentes : chaque question est un feuillet plein qui se déplie. Image facultative à gauche.
import { getCollection } from 'astro:content';
import Photo from './Photo.astro';

interface Props { photo?: string; alt?: string; caption?: string }
const { photo, alt = '', caption } = Astro.props;

const faq = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ data }) => ({
    '@type': 'Question',
    name: data.question,
    acceptedAnswer: { '@type': 'Answer', text: data.answer },
  })),
};
---
<section id="faq">
  <div class="wrap faq-grid">
    <div class="side reveal">
      <h2>Questions fréquentes</h2>
      <p>Une autre question ? <a href="/contact">Écrivez-moi</a> ou réservez l’appel découverte.</p>
      {photo && (
        <figure>
          <Photo name={photo} alt={alt} sizes="(max-width: 1020px) 90vw, 420px" />
          {caption && <figcaption>{caption}</figcaption>}
        </figure>
      )}
    </div>
    <div class="list" data-stagger>
      {faq.map(({ data }) => (
        <details>
          <summary>{data.question}<span class="sign" aria-hidden="true"></span></summary>
          <p>{data.answer}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  #faq { padding: 160px 0; }
  .faq-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 6vw, 96px); align-items: start; }
  h2 { margin-bottom: 16px; }
  .side > p { max-width: 34ch; }
  .side a { color: var(--olive); font-weight: 600; text-underline-offset: 4px; }
  figure { margin: 32px 0 0; }
  figure :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  figcaption { font-size: var(--t-5); color: var(--muted); margin-top: 10px; }
  .list { display: grid; gap: 8px; }
  details { background: var(--paper); transition: background .2s; }
  details[open] { background: var(--anthra); color: var(--creme); }
  summary { list-style: none; cursor: pointer; padding: 24px 64px 24px 28px; font-family: var(--serif); font-size: var(--t-3); line-height: 1.3; position: relative; }
  summary::-webkit-details-marker { display: none; }
  .sign { position: absolute; right: 28px; top: 50%; width: 16px; height: 16px; margin-top: -8px; }
  .sign::before, .sign::after { content: ""; position: absolute; left: 0; top: 7px; width: 16px; height: 2px; background: currentColor; transition: transform .3s var(--ease); }
  .sign::after { transform: rotate(90deg); }
  details[open] .sign::after { transform: rotate(0deg); }
  summary:hover { color: var(--olive); }
  details[open] summary:hover { color: var(--sauge); }
  details p { margin: -8px 0 0; padding: 0 28px 28px; max-width: 60ch; }

  @media (max-width: 1020px) {
    #faq { padding: 96px 0; }
    .faq-grid { grid-template-columns: minmax(0, 1fr); }
    figure { max-width: 520px; }
  }
  @media (max-width: 640px) {
    summary { padding: 20px 52px 20px 20px; font-size: 18px; }
    .sign { right: 20px; }
    details p { padding: 0 20px 22px; }
  }
</style>
