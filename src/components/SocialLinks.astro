---
// Liens LinkedIn et Instagram, discrets, avec leur pictogramme. La couleur suit celle du texte.
import { SOCIAL } from '../config';

interface Props { class?: string }
const { class: className } = Astro.props;
---
<ul class:list={['social', className]}>
  {SOCIAL.map((s) => (
    <li>
      <a href={s.url} target="_blank" rel="noopener">
        {s.icon === 'linkedin' ? (
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M4 2h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm3.5 3.9a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2zM6 10h3v8H6zm5 0h2.9v1.3c.5-.9 1.6-1.5 2.9-1.5 2.4 0 3.2 1.5 3.2 3.9V18h-3v-3.8c0-1-.2-1.9-1.4-1.9s-1.6.9-1.6 1.9V18h-3z" /></svg>
        ) : (
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" /></svg>
        )}
        <span>{s.label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .social { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  a { display: inline-flex; align-items: center; gap: 10px; min-height: 32px; color: inherit; text-decoration: none; font-weight: 600; transition: color .2s; }
  a:hover { color: var(--olive); }
  a:hover span { text-decoration: underline; text-underline-offset: 4px; }
  svg { flex: none; }
</style>
