---
// Accueil : les trois domaines de The Next Move, en une phrase chacun.
import { contactHref } from '../lib/contact';

const axes = [
  { title: 'Orientation & évolution professionnelle', text: 'Construire votre parcours et prendre les bonnes décisions, au début de votre carrière comme au moment d’en changer.', request: 'orientation' },
  { title: 'Organisation & méthodes de travail', text: 'Structurer vos priorités, améliorer vos pratiques et gagner en efficacité, seul ou en équipe.', request: 'organisation' },
  { title: 'Intelligence artificielle & formation', text: 'Comprendre, choisir et utiliser les outils d’IA dans des situations concrètes de travail.', request: 'ia' },
] as const;
---
<section class="axes">
  <div class="wrap grid">
    <h2 class="reveal">Trois domaines d’accompagnement</h2>
    <ul data-stagger>
      {axes.map((a) => (
        <li>
          <h3>{a.title}</h3>
          <p>{a.text} <a href={contactHref(undefined, a.request)}>En parler</a></p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .axes { padding: 160px 0; }
  .grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 56px; }
  h3 { font-size: var(--t-2); margin-bottom: 10px; }
  li p { max-width: 52ch; margin: 0; }
  li a { color: var(--olive); font-weight: 600; text-underline-offset: 3px; white-space: nowrap; }
  @media (max-width: 1020px) {
    .axes { padding: 96px 0; }
    .grid { grid-template-columns: minmax(0, 1fr); }
    ul { gap: 40px; }
  }
</style>
