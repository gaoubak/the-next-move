---
// En-tête des sous-pages : la carte de la page (bande rayée, fil d'Ariane, titre, chapô) à côté d'une image.
// Sans photo, la carte prend toute la largeur.
import Breadcrumb from './Breadcrumb.astro';
import Photo from './Photo.astro';
import Stripe from './Stripe.astro';

interface Props {
  crumbs: { label: string; href?: string }[];
  title: string;
  lead?: string;
  photo?: string;
  alt?: string;
  pos?: string; // object-position de la photo
  caption?: string;
}
const { crumbs, title, lead, photo, alt = '', pos = '50% 50%', caption } = Astro.props;
---
<section class:list={['page-hero', { solo: !photo }]}>
  <div class="wrap grid">
    <div class="card">
      <Stripe height={28} />
      <div class="body enter">
        <Breadcrumb items={crumbs} />
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </div>
    </div>
    {photo && (
      <figure class="pic" style={`--pos:${pos}`}>
        <Photo name={photo} alt={alt} sizes="(max-width: 900px) 100vw, 640px" priority />
        {caption && <figcaption>{caption}</figcaption>}
      </figure>
    )}
  </div>
</section>

<style>
  .page-hero { padding: 12px 0 0; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; min-height: min(calc(100svh - var(--header-h) - 12px), 780px); }
  .solo .grid { grid-template-columns: minmax(0, 1fr); min-height: 0; }
  .card { background: var(--paper); display: flex; flex-direction: column; min-width: 0; }
  .body { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: clamp(32px, 6vh, 72px) clamp(24px, 5vw, 72px); }
  .body :global(.breadcrumb) { margin-bottom: clamp(24px, 5vh, 48px); }
  h1 { font-size: var(--t-1); font-weight: 300; letter-spacing: -.03em; line-height: 1.02; max-width: 14ch; margin-bottom: 24px; }
  .lead { font-size: var(--t-3); line-height: 1.45; max-width: 40ch; margin-bottom: 28px; }
  .body > :last-child { margin-bottom: 0; }

  .pic { margin: 0; position: relative; overflow: hidden; background: var(--creme-2); min-height: 360px; }
  .pic :global(picture), .pic :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pic :global(img) { object-fit: cover; object-position: var(--pos); }
  figcaption { position: absolute; left: 0; bottom: 0; background: var(--paper); color: var(--anthra); font-size: var(--t-5); padding: 10px 16px; max-width: 80%; }

  @media (prefers-reduced-motion: no-preference) {
    .pic { animation: pic-in 1.1s var(--ease) both .15s; }
    .pic :global(img) { animation: drift 24s ease-in-out infinite alternate; }
  }
  @keyframes pic-in { from { opacity: 0; transform: translateY(24px); } }
  @keyframes drift { from { transform: scale(1.02); } to { transform: scale(1.08); } }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 0; min-height: 0; }
    .pic { order: -1; height: 42svh; min-height: 260px; }
    figcaption { display: none; }
    .card { position: relative; z-index: 1; margin-top: -24px; margin-inline: 12px; }
    .solo .card { margin: 0; }
  }
  @media (max-width: 640px) {
    .card { margin-inline: 0; }
    .body { padding: 28px 20px 32px; }
    h1 { font-size: 40px; }
    .lead { font-size: 18px; }
  }
</style>
