---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---
<Base title={`Page introuvable — ${SITE.name}`} noindex>
  <section class="simple">
    <div class="wrap">
      <span class="eyebrow">Erreur 404</span>
      <h1>Cette page n’existe pas (ou plus).</h1>
      <p>Pas d’inquiétude, la suite est par ici.</p>
      <a class="btn btn-primary" href="/">Retour à l’accueil</a>
    </div>
  </section>
</Base>

<style>
  .simple { padding: 120px 0 140px; text-align: center; }
  h1 { font-size: clamp(36px, 5vw, 56px); font-weight: 300; margin-bottom: 20px; }
  p { color: var(--muted); margin-bottom: 36px; }
</style>
