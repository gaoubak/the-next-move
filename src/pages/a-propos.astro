---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config';

const strengths = [
  { title: 'Analyse & conseil', text: 'Comprendre les besoins, identifier les enjeux et proposer une direction claire.' },
  { title: 'Gestion de projet & organisation', text: 'Structurer les étapes, coordonner et transformer les idées en actions.' },
  { title: 'IA & transmission', text: 'Rendre les outils accessibles, accompagner leur appropriation et développer les compétences.' },
];

const background = [
  { k: 'Formation', v: ['Bachelier en Sciences biomédicales', 'Master en Santé publique, Gestion des établissements de soins'] },
  { k: 'Expérience', v: ['Consultante en transformation digitale', 'Cheffe de projet, principalement dans le secteur hospitalier', 'Business Analyst, Product Owner'] },
  { k: 'Formation IA', v: ['Conception et animation de formations à l’IA générative'] },
];
---
<Base title={`À propos — ${SITE.owner} · ${SITE.name}`} description={`Qui est ${SITE.owner} : un parcours entre sciences biomédicales, santé publique, transformation digitale et intelligence artificielle, et ce qui a donné naissance à The Next Move.`}>
  <PageHero
    crumbs={[{ label: 'À propos' }]}
    title="Bonjour, moi c’est Tatiana."
    photo="tatiana-rizk-veste-noire"
    alt={`Portrait de ${SITE.owner}, en veste noire`}
    pos="45% 25%"
  >
    <div class="intro">
      <p>Mon parcours a commencé dans les sciences biomédicales, avec un intérêt particulier pour la médecine et la recherche, avant de se poursuivre dans le domaine de la santé publique et du Hospital Management.</p>
      <p>Aujourd’hui, je travaille comme consultante en transformation digitale et cheffe de projet, principalement dans le secteur hospitalier. J’accompagne les organisations dans leurs projets, en faisant le lien entre les besoins des équipes, les méthodes de travail et les solutions technologiques.</p>
      <p>En parallèle, je développe et anime des formations en intelligence artificielle, avec une conviction : les outils ne sont réellement intéressants que lorsqu’ils répondent à un besoin concret.</p>
    </div>
  </PageHero>

  <section class="why">
    <div class="wrap why-grid">
      <h2 class="reveal">Pourquoi The Next Move ?</h2>
      <div class="reveal">
        <p>Au fil de mes expériences, j’ai réalisé que ce qui m’intéressait le plus ne se limitait pas à la technologie ou à la gestion de projet.</p>
        <p class="strong">C’est avant tout le fait de comprendre une situation, de prendre du recul, de structurer des idées et d’accompagner leur mise en œuvre.</p>
        <p>J’ai créé The Next Move pour réunir ces différentes facettes de mon parcours et les mettre au service de personnes et d’équipes aux besoins variés.</p>
        <p>Qu’il s’agisse de construire un projet professionnel, d’améliorer sa manière de travailler ou d’intégrer l’intelligence artificielle, j’aime partir de la réalité de chacun pour proposer des solutions utiles et adaptées.</p>
      </div>
    </div>
  </section>

  <section class="strengths on-dark">
    <div class="wrap">
      <h2 class="reveal">Ce que j’apporte</h2>
      <ul data-stagger>
        {strengths.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="background">
    <div class="wrap bg-grid">
      <figure class="reveal">
        <Photo name="tatiana-rizk-seance" alt={`${SITE.owner} en séance de travail`} sizes="(max-width: 1020px) 90vw, 420px" />
      </figure>
      <div>
        <h2 class="reveal">Mon parcours en bref</h2>
        <dl data-stagger>
          {background.map((b) => <div><dt>{b.k}</dt><dd>{b.v.join(' · ')}</dd></div>)}
        </dl>
        <div class="btns reveal">
          <a class="btn btn-primary" href="/contact#demande">Demander un appel découverte</a>
          <a class="btn btn-ghost" href="/accompagnements">Découvrir les accompagnements</a>
        </div>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .intro p { max-width: 54ch; margin-bottom: .9em; }
  .intro p:last-child { margin-bottom: 0; }

  .why { padding: 160px 0; background: var(--creme-2); }
  .why-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .why p { font-size: var(--t-3); line-height: 1.55; max-width: 52ch; }
  .why .strong { font-family: var(--serif); font-size: clamp(24px, 2.2vw, 30px); line-height: 1.35; color: var(--olive); }

  .strengths { padding: 140px 0; background: var(--olive); color: var(--creme); }
  .strengths h2 { margin-bottom: 48px; }
  .strengths ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 4vw, 56px); }
  .strengths h3 { font-size: var(--t-2); margin-bottom: 10px; }
  .strengths p { margin: 0; max-width: 34ch; }

  .background { padding: 160px 0; }
  .bg-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  figure { margin: 0; }
  figure :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 30% 30%; }
  .background h2 { margin-bottom: 28px; }
  dl { margin: 0 0 36px; display: grid; gap: 18px; }
  dl div { display: grid; grid-template-columns: 140px 1fr; gap: 16px; }
  dt { font-weight: 600; }
  dd { margin: 0; }

  @media (max-width: 1020px) {
    .why, .strengths, .background { padding: 96px 0; }
    .why-grid, .bg-grid { grid-template-columns: minmax(0, 1fr); }
    .strengths ul { grid-template-columns: minmax(0, 1fr); }
    .strengths p, .why p { max-width: none; }
    figure { max-width: 380px; }
  }
  @media (max-width: 640px) {
    dl div { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .why p { font-size: 18px; }
    .why .strong { font-size: 21px; }
    .btns .btn { width: 100%; }
  }
</style>
